# Auto detect text files and normalize line endings to LF in the repository
* text=auto

# Linux dotfiles should use LF while preserving automatic binary detection
dotfiles/ai/** text=auto eol=lf
dotfiles/hunk/** text=auto eol=lf
dotfiles/kanata/** text=auto eol=lf
dotfiles/kanata-kde/** text=auto eol=lf
dotfiles/lazygit/** text=auto eol=lf
dotfiles/nvim/** text=auto eol=lf
dotfiles/opencode/** text=auto eol=lf
dotfiles/tmux/** text=auto eol=lf
dotfiles/yazi/** text=auto eol=lf
dotfiles/zsh/** text=auto eol=lf

# PowerShell files should always use CRLF line endings
*.ps1 text eol=crlf

# Shell scripts should always use LF line endings
*.sh text eol=lf
*.zsh text eol=lf
*.kbd text eol=lf
.zshrc text eol=lf
.zshenv text eol=lf
.zprofile text eol=lf
.zlogin text eol=lf
.zlogout text eol=lf

# Explicitly declare text files
*.md text
*.yaml text
*.yml text
*.json text
*.css text
*.html text
*.txt text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
linux/assets/cursors/**/cursors/* binary
