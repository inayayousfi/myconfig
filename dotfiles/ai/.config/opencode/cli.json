{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "blacknpink"
  },
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.delete.to.line.start": "none",
    "input.delete": "delete,shift+delete"
  },
  "leader": {
    "timeout": 86400000
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "grouping": "none",
    "permissions": "autoaccept"
  },
  "tabs": {
    "enabled": false
  },
  "prompt": {
    "paste": "full"
  },
  "attention": {
    "notifications": true,
    "sound": true
  }
}
