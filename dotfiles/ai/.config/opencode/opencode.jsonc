{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "{env:HOME}/.bun/bin/playwright-mcp",
          "--headless"
        ],
        "disabled": false
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  }
}
