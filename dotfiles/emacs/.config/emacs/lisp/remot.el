;;; remot.el --- Browser terminal for a graphical Emacs process -*- lexical-binding: t; -*-

;; Version: 0.1.0
;; Package-Requires: ((emacs "31.1") (simple-httpd "1.7") (websocket "1.16"))
;; Keywords: terminals, convenience

;;; Commentary:

;; Remot serves an embedded ghostty-web terminal and connects one
;; authenticated browser to a fresh terminal frame in this Emacs process.
;; The browser assets and the MIT license for ghostty-web 0.4.0 are embedded
;; below, so this file is the complete authored and runtime payload.

;;; Code:

(require 'cl-lib)
(require 'json)
(require 'server)
(require 'simple-httpd)
(require 'subr-x)
(require 'websocket)

(defgroup remot nil
  "Browser terminal access to a graphical Emacs process."
  :group 'environment
  :prefix "remot-")

(defcustom remot-http-port 18080
  "TCP port used for the browser terminal page."
  :type 'integer
  :group 'remot)

(defcustom remot-websocket-port 18081
  "TCP port used for browser terminal input and output."
  :type 'integer
  :group 'remot)

(defcustom remot-username "emacs"
  "Username saved alongside the Remot password in browser password managers."
  :type 'string
  :group 'remot)

(defcustom remot-state-directory
  (file-name-as-directory
   (expand-file-name "remot" (or (getenv "XDG_STATE_HOME")
                                  (expand-file-name ".local/state" "~"))))
  "Private directory containing Remot authentication state."
  :type 'directory
  :group 'remot)

(defcustom remot-context-function nil
  "Function called with the source graphical frame before a client starts.
Its return value is passed unchanged to `remot-initialize-frame-function'."
  :type '(choice (const :tag "No context" nil) function)
  :group 'remot)

(defcustom remot-initialize-frame-function nil
  "Function called with the captured context and new terminal frame."
  :type '(choice (const :tag "No initialization" nil) function)
  :group 'remot)

(defcustom remot-exit-with-last-graphical-frame nil
  "When non-nil, end Emacs when its last graphical frame closes."
  :type 'boolean
  :group 'remot)

(defconst remot-server-name "remot")
(defconst remot-frame-name "remot")
(defconst remot-protocol "remot-v1")
(defconst remot-scrypt-script
  (concat
   "import hashlib, sys\n"
   "password = sys.stdin.buffer.read()\n"
   "salt = bytes.fromhex(sys.argv[1])\n"
   "result = hashlib.scrypt(password, salt=salt, n=2**16, r=8, p=1, "
   "maxmem=128*1024*1024, dklen=32)\n"
   "sys.stdout.write(result.hex())\n"))

(defvar remot-password-record nil)
(defvar remot-websocket-server nil)
(defvar remot-websocket nil)
(defvar remot-pending-websockets nil)
(defvar remot-process nil)
(defvar remot-context nil)
(defvar remot-authentication-failures 0)
(defvar remot-next-authentication-time 0)
(defvar remot-started-p nil)
(defvar remot--asset-cache (make-hash-table :test #'eq))
(defvar remot--index-html-base64)
(defvar remot--style-css-base64)
(defvar remot--app-js-base64)
(defvar remot--ghostty-web-js-base64)
(defvar remot--ghostty-vt-wasm-base64)
(defvar remot--ghostty-web-license-base64)

(defun remot--log (format-string &rest args)
  (apply #'message (concat "Remot: " format-string) args))

(defun remot--password-file ()
  (expand-file-name "password.el" remot-state-directory))

(defun remot--ensure-private-directory (directory)
  (make-directory directory t)
  (set-file-modes directory #o700))

(defun remot--write-data-atomically (file value)
  (remot--ensure-private-directory (file-name-directory file))
  (let ((temporary
         (make-temp-file
          (expand-file-name ".state-" (file-name-directory file)))))
    (unwind-protect
        (progn
          (with-temp-file temporary
            (let ((print-length nil) (print-level nil) (print-circle t))
              (prin1 value (current-buffer))
              (insert "\n")))
          (set-file-modes temporary #o600)
          (rename-file temporary file t))
      (when (file-exists-p temporary)
        (delete-file temporary)))))

(defun remot--read-data (file)
  (with-temp-buffer
    (insert-file-contents file)
    (let ((read-circle t))
      (read (current-buffer)))))

(defun remot-random-salt ()
  "Return 128 random bits as 32 lowercase hexadecimal characters."
  (string-replace
   "-" ""
   (string-trim
    (with-temp-buffer
      (insert-file-contents "/proc/sys/kernel/random/uuid")
      (buffer-string)))))

(defun remot-derive-password (password salt)
  "Derive a hexadecimal scrypt verifier for PASSWORD and SALT."
  (let ((python (or (executable-find "python")
                    (error "Python is required for browser terminal passwords")))
        (output (generate-new-buffer " *remot-password*")))
    (unwind-protect
        (with-temp-buffer
          (set-buffer-multibyte nil)
          (insert (encode-coding-string password 'utf-8-unix t))
          (let ((status
                 (call-process-region
                  (point-min) (point-max) python nil output nil
                  "-c" remot-scrypt-script salt)))
            (unless (and (integerp status) (zerop status))
              (error "Password verifier failed with status %s" status)))
          (with-current-buffer output
            (string-trim (buffer-string))))
      (kill-buffer output))))

(defun remot-password-record-p (record)
  (and (listp record)
       (= (or (plist-get record :version) 0) 1)
       (eq (plist-get record :algorithm) 'scrypt)
       (string-match-p "\\`[0-9a-f]\\{32\\}\\'"
                       (or (plist-get record :salt) ""))
       (string-match-p "\\`[0-9a-f]\\{64\\}\\'"
                       (or (plist-get record :verifier) ""))))

(defun remot-read-password-record ()
  "Read and validate the stored password verifier."
  (let ((file (remot--password-file)))
    (when (file-readable-p file)
      (set-file-modes file #o600)
      (let ((record (remot--read-data file)))
        (unless (remot-password-record-p record)
          (error "Invalid browser terminal password file: %s"
                 file))
        record))))

(defun remot-constant-time-equal (left right)
  "Return non-nil when equal-length unibyte strings LEFT and RIGHT match."
  (when (= (length left) (length right))
    (let ((difference 0))
      (dotimes (index (length left))
        (setq difference
              (logior difference
                      (logxor (aref left index) (aref right index)))))
      (zerop difference))))

(defun remot-password-valid-p (password)
  "Return non-nil when PASSWORD matches the stored verifier."
  (when (and remot-password-record
             (>= (float-time)
                 remot-next-authentication-time))
    (let* ((salt (plist-get remot-password-record :salt))
           (expected
            (plist-get remot-password-record :verifier))
           (actual (remot-derive-password password salt))
           (valid (remot-constant-time-equal actual expected)))
      (if valid
          (setq remot-authentication-failures 0
                remot-next-authentication-time 0)
        (cl-incf remot-authentication-failures)
        (setq remot-next-authentication-time
              (+ (float-time)
                 (min 30
                      (expt 2 (min 5
                                    remot-authentication-failures))))))
      valid)))

(defun remot-set-password ()
  "Set or replace the browser terminal password without a password policy."
  (interactive)
  (let ((password (read-passwd "Browser terminal password: "))
        confirmation)
    (unwind-protect
        (progn
          (setq confirmation (read-passwd "Confirm browser terminal password: "))
          (unless (string-equal password confirmation)
            (user-error "Passwords do not match"))
          (let* ((salt (remot-random-salt))
                 (record
                  (list :version 1 :algorithm 'scrypt :salt salt
                        :verifier
                        (remot-derive-password password salt))))
            (remot--write-data-atomically (remot--password-file) record)
            (setq remot-password-record record
                  remot-authentication-failures 0
                  remot-next-authentication-time 0)
            (remot-close-pending-websockets)
            (remot-disconnect-controller)
            (when (and (display-graphic-p)
                       (not remot-started-p))
              (remot-start))
            (message "Browser terminal password set")))
      (clear-string password)
      (when confirmation (clear-string confirmation)))))

(defun remot-origin-p (origin)
  (and (stringp origin)
       (string-match-p
        (format "\\`http://[^/:]+:%d\\'" remot-http-port)
        origin)))

(defun remot-remote-frames ()
  (cl-remove-if-not
   (lambda (frame) (frame-parameter frame 'remot))
   (frame-list)))

(defun remot-stop-terminal ()
  "Destroy the browser terminal process and all of its text frames."
  (let ((process remot-process))
    (setq remot-process nil)
    (when (process-live-p process)
      (delete-process process)))
  (dolist (frame (remot-remote-frames))
    (when (frame-live-p frame)
      (delete-frame frame t))))

(defun remot-disconnect-controller ()
  "Disconnect the authenticated browser and destroy its terminal."
  (let ((websocket remot-websocket))
    (setq remot-websocket nil)
    (remot-stop-terminal)
    (when (websocket-openp websocket)
      (websocket-close websocket))))

(defun remot-close-pending-websockets ()
  "Close every browser connection which has not authenticated."
  (let ((pending remot-pending-websockets))
    (setq remot-pending-websockets nil)
    (dolist (websocket pending)
      (when (websocket-openp websocket)
        (websocket-close websocket)))))

(defun remot-send-output (_process output)
  (when (websocket-openp remot-websocket)
    (condition-case error
        (websocket-send
         remot-websocket
         (make-websocket-frame :opcode 'binary :payload output :completep t))
      (error
       (remot--log "Terminal output failed: %s"
                   (error-message-string error))))))

(defun remot-process-ended (process event)
  (when (eq process remot-process)
    (setq remot-process nil)
    (dolist (frame (remot-remote-frames))
      (when (frame-live-p frame)
        (delete-frame frame t)))
    (when (websocket-openp remot-websocket)
      (websocket-close remot-websocket)))
  (remot--log "Terminal process ended: %s" (string-trim event)))

(defun remot-source-frame ()
  (if (display-graphic-p (selected-frame))
      (selected-frame)
    (cl-find-if #'display-graphic-p (frame-list))))

(defun remot-start-terminal ()
  "Create a fresh terminal-mode client of this Emacs process."
  (remot-stop-terminal)
  (let* ((source-frame (remot-source-frame))
         (client (or (executable-find "emacsclient")
                     (expand-file-name "emacsclient" invocation-directory)))
         (process-environment (copy-sequence process-environment)))
    (unless source-frame
      (error "No graphical Emacs frame is available"))
    (setq remot-context
          (when remot-context-function
            (funcall remot-context-function source-frame)))
    (setenv "TERM" "xterm-256color")
    (setenv "COLORTERM" "truecolor")
    (setq remot-process
          (make-process
           :name "remot"
           :buffer (get-buffer-create " *remot-pty*")
           :command
           (list client "--socket-name" remot-server-name
                 "--tty" "--frame-parameters"
                 (format "((name . %S) (remot . t))"
                         remot-frame-name))
           :connection-type 'pty
           :coding '(no-conversion . no-conversion)
           :noquery t
           :filter #'remot-send-output
           :sentinel #'remot-process-ended))))

(defun remot-initialize-frame ()
  "Initialize a new browser-owned text frame."
  (when (frame-parameter nil 'remot)
    (when remot-initialize-frame-function
      (funcall remot-initialize-frame-function
               remot-context (selected-frame)))))

(defun remot-websocket-open (websocket)
  (if (not (remot-origin-p (websocket-origin websocket)))
      (websocket-close websocket)
    (push websocket remot-pending-websockets)))

(defun remot-authenticate (websocket message)
  (let ((username (alist-get 'username message))
        (password (alist-get 'password message)))
    (unwind-protect
        (if (and (equal username remot-username)
                 (stringp password)
                 (remot-password-valid-p password))
            (progn
              (setq remot-pending-websockets
                    (delq websocket
                          remot-pending-websockets))
              (remot-disconnect-controller)
              (setq remot-websocket websocket)
              (condition-case error
                  (progn
                    (remot-start-terminal)
                    (websocket-send-text websocket "{\"type\":\"authenticated\"}"))
                (error
                 (setq remot-websocket nil)
                 (websocket-close websocket)
                 (remot--log "Terminal start failed: %s"
                             (error-message-string error)))))
          (progn
            (websocket-send-text
             websocket "{\"type\":\"authentication-failed\"}")
            (websocket-close websocket)))
      (when (stringp password)
        (clear-string password)))))

(defun remot-websocket-message (websocket frame)
  (if (not (eq websocket remot-websocket))
      (if (not (memq websocket remot-pending-websockets))
          (websocket-close websocket)
        (when (eq (websocket-frame-opcode frame) 'text)
          (condition-case error
              (let ((message
                     (json-parse-string (websocket-frame-text frame)
                                        :object-type 'alist)))
                (if (equal (alist-get 'type message) "authenticate")
                    (remot-authenticate websocket message)
                  (websocket-close websocket)))
            (error
             (websocket-close websocket)
             (remot--log "Authentication rejected: %s"
                         (error-message-string error))))))
    (pcase (websocket-frame-opcode frame)
      ('binary
       (when (process-live-p remot-process)
         (process-send-string remot-process
                              (websocket-frame-payload frame))))
      ('text
       (condition-case error
           (let* ((message (json-parse-string (websocket-frame-text frame)
                                              :object-type 'alist))
                  (type (alist-get 'type message))
                  (cols (alist-get 'cols message))
                  (rows (alist-get 'rows message)))
             (when (and (equal type "resize")
                        (integerp cols) (<= 20 cols 500)
                        (integerp rows) (<= 5 rows 200)
                        (process-live-p remot-process))
               (set-process-window-size remot-process rows cols)))
         (error
          (remot--log "Terminal message rejected: %s"
                      (error-message-string error))))))))

(defun remot-websocket-close (websocket)
  (setq remot-pending-websockets
        (delq websocket remot-pending-websockets))
  (when (eq websocket remot-websocket)
    (setq remot-websocket nil)
    (remot-stop-terminal)))

(defun remot--asset (name)
  "Decode and cache embedded asset NAME as a unibyte string."
  (or (gethash name remot--asset-cache)
      (puthash
       name
       (base64-decode-string
        (pcase name
          ('index-html remot--index-html-base64)
          ('style-css remot--style-css-base64)
          ('app-js remot--app-js-base64)
          ('ghostty-web-js remot--ghostty-web-js-base64)
          ('ghostty-vt-wasm remot--ghostty-vt-wasm-base64)
          ('ghostty-web-license remot--ghostty-web-license-base64)
          (_ (error "Unknown Remot asset: %s" name))))
       remot--asset-cache)))

(defun remot--text-asset (name)
  (decode-coding-string (remot--asset name) 'utf-8))

(defun remot--index-html ()
  (encode-coding-string
   (string-replace "@@REMOT_USERNAME@@"
                   (httpd-escape-html remot-username)
                   (remot--text-asset 'index-html))
   'utf-8 t))

(defun remot--app-js ()
  (encode-coding-string
   (string-replace "@@REMOT_WEBSOCKET_PORT@@"
                   (number-to-string remot-websocket-port)
                   (remot--text-asset 'app-js))
   'utf-8 t))

(defun remot--serve-asset (process mime contents)
  (httpd-with-buffer process mime
    (set-buffer-multibyte nil)
    (insert contents)))

(defun remot--http-dispatch (_original process uri-path _query _request)
  "Serve Remot's embedded browser assets."
  (pcase uri-path
    ((or "/" "/index.html" "/login")
     (remot--serve-asset process "text/html" (remot--index-html)))
    ("/style.css"
     (remot--serve-asset process "text/css" (remot--asset 'style-css)))
    ("/app.js"
     (remot--serve-asset process "text/javascript" (remot--app-js)))
    ("/ghostty-web.js"
     (remot--serve-asset process "text/javascript"
                         (remot--asset 'ghostty-web-js)))
    ("/ghostty-vt.wasm"
     (remot--serve-asset process "application/wasm"
                         (remot--asset 'ghostty-vt-wasm)))
    ("/ghostty-web.LICENSE"
     (remot--serve-asset process "text/plain"
                         (remot--asset 'ghostty-web-license)))
    (_ (httpd-error process 404))))

(defun remot-last-graphical-frame-closing (frame)
  "End normal-process Emacs when FRAME is its final graphical frame."
  (when (and remot-exit-with-last-graphical-frame
             (display-graphic-p frame)
             (not (cl-some (lambda (other)
                             (and (not (eq other frame))
                                  (frame-live-p other)
                                  (display-graphic-p other)))
                           (frame-list))))
    (kill-emacs)))

(defun remot-stop ()
  "Stop all browser terminal listeners and clients."
  (remot-disconnect-controller)
  (remot-close-pending-websockets)
  (when (process-live-p remot-websocket-server)
    (websocket-server-close remot-websocket-server))
  (setq remot-websocket-server nil)
  (when (httpd-running-p)
    (httpd-stop))
  (when (advice-member-p #'remot--http-dispatch 'httpd/)
    (advice-remove 'httpd/ #'remot--http-dispatch))
  (setq remot-started-p nil))

(defun remot-start ()
  "Start browser terminal listeners for an existing password verifier."
  (unless (display-graphic-p)
    (user-error "Browser terminal requires a graphical Emacs frame"))
  (unless remot-password-record
    (user-error "Set a browser terminal password first"))
  (unless remot-started-p
    (setq server-name remot-server-name)
    (server-start nil t)
    (setq httpd-host "0.0.0.0"
          httpd-port remot-http-port
          httpd-root nil
          httpd-serve-files nil
          httpd-listings nil
          httpd-log-buffer nil)
    (unless (advice-member-p #'remot--http-dispatch 'httpd/)
      (advice-add 'httpd/ :around #'remot--http-dispatch))
    (httpd-start)
    (setq remot-websocket-server
          (websocket-server
           remot-websocket-port
           :host "0.0.0.0"
           :protocol (list remot-protocol)
           :on-open #'remot-websocket-open
           :on-message #'remot-websocket-message
           :on-close #'remot-websocket-close))
    (setq remot-started-p t)
    (remot--log "Listening on LAN ports %d and %d"
                remot-http-port
                remot-websocket-port)))

(defun remot-setup ()
  "Configure Remot for the current graphical GNU/Linux Emacs process."
  (when (and (eq system-type 'gnu/linux) (display-graphic-p))
    (setq remot-password-record
          (remot-read-password-record))
    (add-hook 'server-after-make-frame-hook
              #'remot-initialize-frame)
    (add-hook 'delete-frame-functions
              #'remot-last-graphical-frame-closing t)
    (add-hook 'kill-emacs-hook #'remot-stop)
    (if remot-password-record
        (remot-start)
      (remot--log "Disabled; run M-x remot-set-password"))))

