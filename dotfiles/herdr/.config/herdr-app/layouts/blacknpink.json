{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "edge",
      "type": "column",
      "children": [],
      "background": "chrome",
      "size": {
        "px": 56
      },
      "min": 56,
      "max": 56,
      "window_drag": true
    },
    {
      "id": "actions",
      "type": "block",
      "content": {
        "mod": "blacknpink-buttons"
      },
      "size": {
        "px": 48
      },
      "min": 48,
      "max": 48,
      "window_drag": true,
      "padding": [
        12,
        3
      ],
      "background": "chrome"
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "blacknpink-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": false
                }
              }
            }
          ],
          "padding": 8,
          "gap": 8
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "blacknpink",
  "font": "BlexMono Nerd Font",
  "window_blur": true,
  "terminal_opacity": 0,
  "colors": {
    "canvas": "#000000d9",
    "background": "#00000000",
    "chrome": "#00000000"
  },
  "floating": [
    {
      "id": "drawer",
      "content": {
        "mod": "blacknpink-drawer"
      },
      "edge": "left",
      "align": "start",
      "peek": 40
    }
  ]
}
