[Unit]
Description=InayOS Kanata KDE tray
After=graphical-session.target inayos-kanata.service
Wants=inayos-kanata.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/inayos-kanata-tray
ExecStopPost=-/usr/bin/systemctl --user stop inayos-kanata.service
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
