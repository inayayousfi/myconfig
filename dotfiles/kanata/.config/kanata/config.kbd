(defcfg
  process-unmapped-keys yes
)

(defsrc
  a    s    d    f    j    k    l    scln
  z    w    c    v    1    2    3    q    f1
  f17  f18  f19
)

(defalias
  src use-defsrc

  hr-a    (tap-hold 0 400 a lmet)
  hr-s    (tap-hold 0 400 s lalt)
  hr-d    (tap-hold 0 400 d lctl)
  hr-f    (tap-hold 0 400 f lsft)
  hr-j    (tap-hold 0 400 j rsft)
  hr-k    (tap-hold 0 400 k rctl)
  hr-l    (tap-hold 0 400 l ralt)
  hr-scln (tap-hold 0 400 scln rmet)

  dis-z (tap-hold 0 400 z lmet)
  dis-a (tap-hold 0 400 a lalt)
  dis-s (tap-hold 0 400 s lctl)
  dis-w (tap-hold 0 400 w lsft)

  valo-2  (tap-hold 0 400 e q)
  valo-1  (tap-hold 0 400 . b)
  valo-q  (tap-hold 0 400 = g)
  valo-f1 (tap-hold 0 400 i f)
  valo-3  (tap-hold 0 400 v r)
  valo-z  (tap-hold 0 400 c n)

  scroll-up   (mwheel-up 50 120)
  scroll-down (mwheel-down 50 120)
  overview    M-w
)

(deflayer off
  @src @src @src @src @src @src @src @src
  @src @src @src @src @src @src @src @src @src
  @scroll-up @scroll-down @overview
)

(deflayer homerow
  @hr-a @hr-s @hr-d @hr-f @hr-j @hr-k @hr-l @hr-scln
  @src  @src  @src  @src  @src  @src  @src  @src     @src
  @scroll-up @scroll-down @overview
)

(deflayer disabled
  @dis-a @dis-s @src @src @src @src @src @src
  @dis-z @dis-w @scroll-up @scroll-down @src @src @src @src @src
  @scroll-up @scroll-down @overview
)

(deflayer valo
  @src d    @src @src @src @src @src @src
  @valo-z @src @src @src @valo-1 @valo-2 @valo-3 @valo-q @valo-f1
  @scroll-up @scroll-down @overview
)
