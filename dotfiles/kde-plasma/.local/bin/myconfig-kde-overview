#!/usr/bin/env bash

set -euo pipefail

scale="${MYCONFIG_OVERVIEW_SCALE:-2}"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
lock_file="$runtime_dir/myconfig-kde-overview.lock"
declare -a outputs=()
scaled=false

exec 9>"$lock_file"
flock -n 9 || exit 0

overview_active() {
    qdbus6 org.kde.KWin /Effects \
        org.freedesktop.DBus.Properties.Get org.kde.kwin.Effects activeEffects \
        | grep -Fxq overview
}

toggle_overview() {
    qdbus6 org.kde.kglobalaccel /component/kwin \
        org.kde.kglobalaccel.Component.invokeShortcut Overview >/dev/null
}

restore_outputs() {
    [ "$scaled" = true ] || return 0

    local -a settings=()
    local output
    for output in "${outputs[@]}"; do
        settings+=("output.${output%%$'\t'*}.scale.${output#*$'\t'}")
    done
    kscreen-doctor "${settings[@]}" >/dev/null
    scaled=false
}

trap restore_outputs EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if overview_active; then
    toggle_overview
    exit 0
fi

mapfile -t outputs < <(
    kscreen-doctor --json \
        | jq -r '.outputs[] | select(.connected and .enabled) | [.name, (.scale | tostring)] | @tsv'
)
[ "${#outputs[@]}" -gt 0 ] || {
    printf 'No enabled display output found\n' >&2
    exit 1
}

scale_settings=()
for output in "${outputs[@]}"; do
    scale_settings+=("output.${output%%$'\t'*}.scale.$scale")
done
kscreen-doctor "${scale_settings[@]}" >/dev/null
scaled=true

toggle_overview

for _ in {1..40}; do
    overview_active && break
    sleep 0.05
done
overview_active || exit 1

while overview_active; do
    sleep 0.1
done
