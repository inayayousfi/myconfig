#!/usr/bin/env bash

set -euo pipefail

# install.sh keeps the CachyOS installer here; it rebuilds Glass for the running KWin.
myconfig="$HOME/.local/bin/myconfig"
if [ ! -x "$myconfig" ]; then
    printf 'MyConfig is not installed at %s\n' "$myconfig" >&2
    exit 1
fi
exec "$myconfig" internal kde-plasma repair-glass
