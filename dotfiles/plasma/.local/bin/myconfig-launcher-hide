#!/usr/bin/env bash
# Hides the launcher entries of development tools that required packages
# install, and duplicate entries that packages add beside their main entry.
# KDE ignores Hidden=true overrides, so each entry is hidden by a copy of the
# installed entry with NoDisplay=true. Run it again after package updates so
# the copies follow the installed entries.
set -euo pipefail

entries=(
    assistant designer linguist qdbusviewer
    jconsole-java-openjdk jshell-java-openjdk cmake-gui
    lstopo qv4l2 qvidcap
    scrcpy scrcpy-console org.kde.plasma.emojier
    vscodium-wayland
)
marker="# Generated by myconfig-launcher-hide from"
target_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
changed=false

installed_entry() {
    local dir
    local -a dirs
    IFS=: read -r -a dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for dir in "${dirs[@]}"; do
        dir="${dir%/}"
        if [ -f "$dir/applications/$1" ]; then
            printf '%s\n' "$dir/applications/$1"
            return 0
        fi
    done
    return 1
}

mkdir -p "$target_dir"
for entry in "${entries[@]}"; do
    target="$target_dir/$entry.desktop"
    if [ -L "$target" ] || { [ -e "$target" ] && ! head -n 1 "$target" | grep -Fq "$marker"; }; then
        echo "myconfig-launcher-hide: leaving $target, which it did not write" >&2
        continue
    fi

    if ! source="$(installed_entry "$entry.desktop")"; then
        if [ -e "$target" ]; then
            rm -- "$target"
            changed=true
        fi
        continue
    fi

    content="$(
        printf '%s %s\n' "$marker" "$source"
        awk '
            /^\[/ { group = $0 }
            group == "[Desktop Entry]" && /^(NoDisplay|Hidden)[[:space:]]*=/ { next }
            { print }
            $0 == "[Desktop Entry]" { print "NoDisplay=true" }
        ' "$source"
    )"
    if [ ! -e "$target" ] || [ "$(cat -- "$target")" != "$content" ]; then
        printf '%s\n' "$content" >"$target.tmp"
        mv -- "$target.tmp" "$target"
        changed=true
    fi
done

if $changed && command -v kbuildsycoca6 >/dev/null 2>&1; then
    kbuildsycoca6 >/dev/null 2>&1 || echo "myconfig-launcher-hide: could not refresh KDE's application list" >&2
fi
