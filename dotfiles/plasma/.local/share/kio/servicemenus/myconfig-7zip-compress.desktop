[Desktop Entry]
Type=Service
MimeType=all/all;
Actions=7z;zip
X-KDE-Submenu=Compress
X-KDE-Submenu[fr]=Compresser

[Desktop Action 7z]
Name=To .7z
Name[fr]=En .7z
Icon=application-x-7z-compressed
Exec=sh -c '"$HOME/.local/bin/myconfig-7z" compress 7z "$@"' myconfig-7z %F

[Desktop Action zip]
Name=To .zip
Name[fr]=En .zip
Icon=application-zip
Exec=sh -c '"$HOME/.local/bin/myconfig-7z" compress zip "$@"' myconfig-7z %F
