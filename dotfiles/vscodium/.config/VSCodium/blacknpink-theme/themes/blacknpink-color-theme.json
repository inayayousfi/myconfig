  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#4a4f5e", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.regexp", "markup.inline.raw"],
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#facc15" }
    },
    {
      "scope": [
        "constant",
        "constant.character.escape",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#22d3ee" }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word"
      ],
      "settings": { "foreground": "#ff4ead", "fontStyle": "bold" }
    },
    {
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#d0d6e0", "fontStyle": "" }
    },
    {
      "scope": ["support.function.builtin", "variable.language", "support.variable"],
      "settings": { "foreground": "#ff4ead" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "entity.name.tag"],
      "settings": { "foreground": "#ff85c8" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in"
      ],
      "settings": { "foreground": "#f0f2f7", "fontStyle": "bold" }
    },
    {
      "scope": ["variable", "variable.parameter", "variable.other.property"],
      "settings": { "foreground": "#d0d6e0" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#22d3ee" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#ff4ead", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#ff4ead" }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#f87171" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#facc15" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f87171" }
    }
  ],
  "semanticTokenColors": {
    "comment": { "foreground": "#4a4f5e", "italic": true },
    "string": "#4ade80",
    "number": "#facc15",
    "keyword": { "foreground": "#ff4ead", "bold": true },
    "selfKeyword": "#ff4ead",
    "function": "#ff85c8",
    "method": "#ff85c8",
    "macro": "#ff85c8",
    "type": { "foreground": "#f0f2f7", "bold": true },
    "class": { "foreground": "#f0f2f7", "bold": true },
    "struct": { "foreground": "#f0f2f7", "bold": true },
    "enum": { "foreground": "#f0f2f7", "bold": true },
    "interface": { "foreground": "#f0f2f7", "bold": true },
    "typeParameter": { "foreground": "#f0f2f7", "bold": true },
    "builtinType": { "foreground": "#f0f2f7", "bold": true },
    "namespace": "#f0f2f7",
    "enumMember": "#22d3ee",
    "variable": "#d0d6e0",
    "parameter": "#d0d6e0",
    "property": "#d0d6e0",
    "operator": "#d0d6e0",
    "lifetime": "#a78bfa"
  }
}
