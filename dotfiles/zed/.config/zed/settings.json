{
  "file_finder": {
    "modal_max_width": "medium",
  },
  "search": {
    "center_on_match": true,
  },
  "completions": {
    "words_min_length": 1,
    "words": "enabled",
  },
  "completion_menu_item_kind": "symbol",
  "inlay_hints": {
    "show_background": true,
    "enabled": true,
  },
  "colorize_brackets": true,
  "code_lens": "on",
  "allow_rewrap": "anywhere",
  "toolbar": {
    "code_actions": true,
  },
  "inline_code_actions": false,
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "show_edit_predictions": false,
  "agent": {
    "limit_content_width": true,
    "default_width": 280.0,
    "flexible": false,
    "default_profile": "ask",
    "default_model": {
      "provider": "ollama",
      // ollama pull gemma4:latest
      "model": "gemma4:latest",
      "enable_thinking": true,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
    "show_turn_stats": true,
  },
  "agent_servers": {
    "opencode": {
      "favorite_config_option_values": {
        "model": ["openai/gpt-5.5"],
      },
      "type": "registry",
    },
  },
  "auto_update": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 2000,
    },
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "buffer_font_size": 20,
  "buffer_font_weight": 450,
  "buffer_line_height": "standard",
  "collaboration_panel": {
    "dock": "left",
  },
  "completion_menu_scrollbar": "always",
  "edit_predictions": {
    "mode": "eager",
    "provider": "ollama",
    "ollama": {
      "api_url": "http://127.0.0.1:11434",
      // ollama pull hf.co/bartowski/zed-industries_zeta-2-GGUF:Q4_0
      "model": "hf.co/bartowski/zed-industries_zeta-2-GGUF:Q4_0",
      "prompt_format": "zeta2",
      "max_output_tokens": 256,
    },
  },
  "git_panel": {
    "commit_title_max_length": 80,
    "scrollbar": {
      "show": "auto",
    },
    "tree_view": true,
    "status_style": "label_color",
    "default_width": 240.0,
    "dock": "right",
  },
  "gutter": {
    "folds": false,
  },
  "hide_mouse": "never",
  "icon_theme": "Zed (Default)",
  "max_tabs": 1,
  "on_last_window_closed": "quit_app",
  "outline_panel": {
    "dock": "right",
  },
  "project_panel": {
    "auto_open": {
      "on_create": false,
    },
    "diagnostic_badges": true,
    "scrollbar": {
      "show": "auto",
    },
    "entry_spacing": "standard",
    "dock": "right",
  },
  "relative_line_numbers": "enabled",
  "restore_on_startup": "launchpad",
  "rounded_selection": false,
  "scrollbar": {
    "show": "never",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "soft_wrap": "editor_width",
  "tab_bar": {
    "show": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "scrollbar": {
      "show": "always",
    },
  },
  "theme": "Black & Pink",
  "title_bar": {
    "button_layout": "platform_default",
    "show_branch_status_icon": true,
    "show_menus": false,
    "show_onboarding_banner": true,
    "show_sign_in": false,
    "show_user_menu": false,
    "show_user_picture": false,
  },
  "ui_font_family": "Iosevka Nerd Font",
  "ui_font_size": 20,
  "ui_font_weight": 450,
  "unnecessary_code_fade": 0,
  "vim": {
    "gdefault": true,
    "toggle_relative_line_numbers": true,
  },
  "vim_mode": true,
  "when_closing_with_no_tabs": "keep_window_open",
}
