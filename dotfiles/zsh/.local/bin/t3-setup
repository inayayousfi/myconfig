#!/usr/bin/env bash
# Bring T3 Code to a working, linked, headless background service on this machine.
#
# Safe to re-run. The last step always restarts the service, whether or not the
# nightly version moved, so a bare `t3c` is also how you kick a wedged server.
# That restart drops every session running inside the server, because the unit
# sets KillMode=control-group. The first guard below refuses to run at all from
# a shell inside that group, so the restart can never kill its own caller.
#
# Machine prerequisites (polkit, lingering) are checked, never installed. Those
# belong to windows/setup-arch-wsl.ps1.
set -euo pipefail

UNIT="t3code"
BOOT_LOG="$HOME/.t3/userdata/logs/boot-service.log"
STATE_FILE="$HOME/.t3/runtime/service-state.json"
# The live server rewrites this on every start. It carries the port it bound and
# the moment it came up, which is what the readiness poll below waits on.
RUNTIME_FILE="$HOME/.t3/userdata/server-runtime.json"
# A ceiling, not a cost. The poll normally returns in a couple of seconds. This
# only has to outlast the worst legitimate start, which is a first install
# compiling the native terminal binding.
READY_TIMEOUT=120

log() { printf '[t3-setup] %s\n' "$*"; }
fail() {
    printf '[t3-setup] ERROR: %s\n' "$*" >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Guards
# ---------------------------------------------------------------------------

# A terminal opened inside the T3 Code app is a child of the service, so it lands
# in the service's cgroup. Restarting the unit kills that whole cgroup, which
# takes this script down mid-run. The service install step restarts too, so the
# script already dies there today whenever the version moves. Refuse up front
# instead: this is the cheapest check and the one most likely to fire.
#
# A missing cgroup file means no systemd cgroup at all, so there is nothing to
# protect against and the run continues.
if grep -qF "/$UNIT.service" /proc/self/cgroup 2>/dev/null; then
    fail "this shell runs inside the T3 Code server, so restarting it would kill this run mid-step. Open a terminal outside the app, then run 't3c' there."
fi

[ "$(uname -s)" = "Linux" ] ||
    fail "the T3 Code background service is Linux and systemd only."

command -v bun >/dev/null 2>&1 ||
    fail "bun is missing. It provides the global t3 binary."

command -v jq >/dev/null 2>&1 ||
    fail "jq is missing. It reads the T3 Connect status. Run: paru -S jq"

command -v curl >/dev/null 2>&1 ||
    fail "curl is missing. The restart check probes the server with it. Run: paru -S curl"

# The T3 service does not run from the bun global install. It pins its own copy by
# running `npm install --prefix ~/.t3/runtime/versions/<version>`, because it ships
# native dependencies that a copied bundle cannot carry.
command -v npm >/dev/null 2>&1 ||
    fail "npm is missing. The T3 service installs its pinned runtime with it. Run: paru -S npm"

case "$(systemctl is-system-running 2>/dev/null || true)" in
running | degraded | starting | maintenance) ;;
*)
    fail "systemd is not running. Set '[boot] systemd=true' in /etc/wsl.conf, then run 'wsl --shutdown' from Windows."
    ;;
esac

# `systemctl --user` finds the user manager through this. A session normally sets it,
# but a stripped environment (provisioning, cron) does not. Without it the checks
# below report "unknown" and a healthy service looks broken.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[ -d "$XDG_RUNTIME_DIR" ] ||
    fail "no user runtime directory at $XDG_RUNTIME_DIR, so systemctl --user cannot reach the user manager."

# ---------------------------------------------------------------------------
# Prerequisites, checked only
# ---------------------------------------------------------------------------

# logind consults polkit before allowing a user to set its own lingering. With no
# polkit present there is nobody to ask, so the call is denied outright.
command -v polkitd >/dev/null 2>&1 || [ -x /usr/lib/polkit-1/polkitd ] ||
    fail "polkit is missing, so logind denies the lingering call. Run: paru -S polkit"

# Lingering is what keeps the user's systemd instance alive with no shell open.
# Without it a user service dies the moment you close the terminal.
if [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || echo no)" != "yes" ]; then
    fail "lingering is off, so user services die when you close the shell. Run: sudo loginctl enable-linger $USER"
fi

# ---------------------------------------------------------------------------
# Install or update t3
# ---------------------------------------------------------------------------

log "Updating t3 to the newest nightly"
bun add -g t3@nightly >/dev/null

T3_BIN="$(bun pm bin -g)/t3"
[ -x "$T3_BIN" ] || fail "t3 is not executable at $T3_BIN after install."

CLI_VERSION="$("$T3_BIN" --version)"
log "Using $CLI_VERSION at $T3_BIN"
# `t3 --version` prints "t3 v<version>". Only the bare version compares.
CLI_VERSION="${CLI_VERSION#t3 v}"

# ---------------------------------------------------------------------------
# Warn when this CLI would move the server backwards
# ---------------------------------------------------------------------------

# The server updates itself in place while it runs, and its self-update refuses
# any target that is not strictly newer. The service install has no such floor:
# it writes this CLI's version into the state file flat. So a CLI behind the
# running server silently drags the server back to the older build. Both pull the
# same nightly tag, so this only bites on a tag rollback. Warn, never block: a
# repair run has to stay possible.
if SERVER_VERSION="$(jq -re '.activeVersion' "$STATE_FILE" 2>/dev/null)" &&
    [ "$SERVER_VERSION" != "$CLI_VERSION" ] &&
    [ "$(printf '%s\n%s\n' "$CLI_VERSION" "$SERVER_VERSION" | sort -V | head -n 1)" = "$CLI_VERSION" ]; then
    log "WARNING: this CLI ($CLI_VERSION) is older than the running server ($SERVER_VERSION)."
    log "WARNING: installing the service will pin the server back to $CLI_VERSION."
fi

# ---------------------------------------------------------------------------
# Expose t3 on the system path
# ---------------------------------------------------------------------------

# The Windows desktop app starts its backend with `wsl.exe -d <distro> -- t3`
# when wslBackendEnabled is set. That runs a non-interactive shell, and those
# never read .zshrc, so the bun global bin directory that .zshrc appends to PATH
# is invisible and the lookup fails outright. /usr/local/bin is on the default
# PATH for every shell, interactive or not.
#
# The link points at the bun shim rather than at its target, so a `bun add -g`
# upgrade that rewrites the underlying dist file keeps the link valid.
SYSTEM_BIN="/usr/local/bin/t3"

if [ "$(readlink "$SYSTEM_BIN" 2>/dev/null || true)" = "$T3_BIN" ]; then
    log "System link already points at $T3_BIN"
else
    log "Linking $SYSTEM_BIN to $T3_BIN"
    sudo ln -sfn "$T3_BIN" "$SYSTEM_BIN" ||
        fail "could not create $SYSTEM_BIN."
fi

# A dangling link is worse than no link. It fails with "no such file" instead of
# "command not found", which sends you hunting in the wrong place.
[ -x "$SYSTEM_BIN" ] ||
    fail "$SYSTEM_BIN does not resolve to an executable."

# ---------------------------------------------------------------------------
# Let the native terminal binding compile
# ---------------------------------------------------------------------------

# npm 12 refuses to run the install scripts of a dependency unless that package is
# approved in its allow-scripts setting. It only prints a warning, then exits 0. So
# the pinned runtime installs "successfully" with its native terminal binding
# (node-pty) left uncompiled, and the service dies at startup with
# NodePtyModuleLoadError. That package publishes prebuilt binaries for macOS and
# Windows only, so Linux has to compile it here.
NPMRC="$HOME/.npmrc"
ALLOW_LINE='allow-scripts[]=node-pty'

if [ -f "$NPMRC" ] && grep -qxF "$ALLOW_LINE" "$NPMRC"; then
    log "npm already allows the node-pty install script"
else
    log "Allowing the node-pty install script in $NPMRC"
    # Without this a file that ends mid-line would glue the entry onto that line.
    if [ -s "$NPMRC" ] && [ -n "$(tail -c 1 "$NPMRC")" ]; then
        printf '\n' >>"$NPMRC"
    fi
    printf '%s\n' "$ALLOW_LINE" >>"$NPMRC"
fi

# A runtime installed before that line existed is broken and stays broken. T3 writes
# a sentinel file beside it and skips the reinstall while the file is there. So drop
# any tree whose terminal binding has no loadable Linux binary, and let the service
# install below build a fresh one.
RUNTIME_VERSIONS="$HOME/.t3/runtime/versions"
NODE_ARCH="$(node -p 'process.arch')"

for version_dir in "$RUNTIME_VERSIONS"/*/; do
    pty_dir="${version_dir%/}/node_modules/node-pty"
    [ -d "$pty_dir" ] || continue

    if [ -f "$pty_dir/build/Release/pty.node" ] ||
        [ -f "$pty_dir/build/Debug/pty.node" ] ||
        [ -f "$pty_dir/prebuilds/linux-$NODE_ARCH/pty.node" ]; then
        continue
    fi

    log "Discarding ${version_dir%/}, its terminal binding never compiled"
    rm -rf "${version_dir%/}"
done

# ---------------------------------------------------------------------------
# Install the background service
# ---------------------------------------------------------------------------

# T3's installer finishes with `loginctl enable-linger` and passes no username, so
# logind has to resolve "self" from the caller's login session. WSL starts shells
# through /init rather than PAM, so no session exists and the step always fails,
# which rolls the whole install back. machinectl supplies a real session.
log "Installing the service inside a login session"
install_out=""
if ! install_out="$(sudo machinectl shell "$USER@" "$T3_BIN" service install 2>&1)"; then
    printf '%s\n' "$install_out" >&2
    fail "could not open a login session with machinectl."
fi

# machinectl reports success even when the wrapped command fails, so the exit code
# above proves nothing about the install. Check the resulting unit instead.
enabled="$(systemctl --user is-enabled "$UNIT" 2>/dev/null || true)"
active="$(systemctl --user is-active "$UNIT" 2>/dev/null || true)"
if [ "$enabled" != "enabled" ] || [ "$active" != "active" ]; then
    printf '%s\n' "$install_out" >&2
    fail "service is enabled=${enabled:-unknown} active=${active:-unknown}. See $BOOT_LOG"
fi

log "Service is enabled and running"

# ---------------------------------------------------------------------------
# Link T3 Connect
# ---------------------------------------------------------------------------

linked="$("$T3_BIN" connect status --json 2>/dev/null | jq -r '.linked // false' 2>/dev/null || echo false)"

if [ "$linked" = "true" ]; then
    log "T3 Connect is already linked"
elif [ -t 0 ]; then
    log "Linking T3 Connect without a browser"
    "$T3_BIN" connect link --headless
else
    log "No terminal attached, skipping the link step."
    log "Run 't3c' after your first login to finish linking."
fi

# ---------------------------------------------------------------------------
# Restart the server
# ---------------------------------------------------------------------------

# The service install above restarts the unit too, but only when it actually runs,
# and it is skipped whenever the state file already records this CLI version. That
# skip is the common case, so the restart has to be unconditional here for `t3c` to
# be a dependable way to kick the server. The guard at the top of this file is what
# makes this safe: no caller of this script sits in the cgroup about to be killed.

# Remember which server is up now, so the poll below can tell the replacement
# from the one about to die. A missing file reads as empty, and any stamp the new
# server writes differs from that.
started_before="$(jq -r '.startedAt // empty' "$RUNTIME_FILE" 2>/dev/null || true)"

log "Restarting the server so it picks up this install"
log "Every session running inside it is dropped now"

systemctl --user restart "$UNIT" ||
    fail "could not restart $UNIT. See $BOOT_LOG"

restarts_before="$(systemctl --user show "$UNIT" -p NRestarts --value 2>/dev/null || echo unknown)"

# The unit is Type=simple, so restart returns the moment the process forks, and a
# unit reading "active" only proves the launcher forked something. Wait on the
# server's own readiness signal instead, the same one `t3 pair` uses to find a
# live server: a freshly stamped runtime file, then its environment descriptor
# answering with parseable JSON.
#
# Do not probe /health. It falls through to the single-page app and returns 200
# with HTML for any path at all, so it proves nothing beyond a held socket. The
# descriptor is discriminating because it has to parse.
#
# The origin comes out of the runtime file rather than a fixed port, since the
# server takes --port and a fixed guess would break the moment it moves.
server_version=""
deadline=$((SECONDS + READY_TIMEOUT))

while [ "$SECONDS" -lt "$deadline" ]; do
    started_now="$(jq -r '.startedAt // empty' "$RUNTIME_FILE" 2>/dev/null || true)"

    if [ -n "$started_now" ] && [ "$started_now" != "$started_before" ]; then
        origin="$(jq -r '.origin // empty' "$RUNTIME_FILE" 2>/dev/null || true)"

        if [ -n "$origin" ] && server_version="$(curl -fsS --max-time 5 \
            "$origin/.well-known/t3/environment" 2>/dev/null |
            jq -re '.serverVersion' 2>/dev/null)"; then
            break
        fi
    fi

    server_version=""
    sleep 1
done

[ -n "$server_version" ] ||
    fail "the server never answered within ${READY_TIMEOUT}s of the restart. See $BOOT_LOG"

# Answering once is not staying up. A server that dies right after binding is
# relaunched every RestartSec=5, and each relaunch moves this counter. Comparing
# two post-restart reads catches that, and sidesteps whether an explicit restart
# resets the counter, which is undocumented.
restarts_after="$(systemctl --user show "$UNIT" -p NRestarts --value 2>/dev/null || echo unknown)"
state="$(systemctl --user is-active "$UNIT" 2>/dev/null || true)"

if [ "$state" != "active" ] || [ "$restarts_after" != "$restarts_before" ]; then
    fail "the server answered but did not stay up: state=${state:-unknown}, relaunches went from $restarts_before to $restarts_after. See $BOOT_LOG"
fi

log "Server is back up on $server_version"

log "Done"
