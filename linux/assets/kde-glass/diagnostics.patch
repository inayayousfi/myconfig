+QString BlurEffect::debug(const QString &) const
+{
+    QString result = QStringLiteral("valid=%1 shaders=%2 attempts=%3 noRegion=%4 rejected=%5 draws=%6 tracked=%7 whitelist=%8 classes=%9 physical=%10 strength=%11 excludeWindows=%12 excludeDocks=%13 excludeMenus=%14 excludeTooltips=%15 excludeOSD=%16\n")
