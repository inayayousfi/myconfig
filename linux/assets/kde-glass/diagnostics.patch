+        result += QStringLiteral("%1 visible=%2 requested=%3x%4 tracked=%5 dock=%6 tooltip=%7 menu=%8 dropdown=%9 popupMenu=%10 popupWindow=%11\n")
+            .arg(w->caption()).arg(w->isVisible()).arg(region.width()).arg(region.height()).arg(m_windows.contains(w)).arg(w->isDock()).arg(w->isTooltip()).arg(w->isMenu()).arg(w->isDropdownMenu()).arg(w->isPopupMenu()).arg(w->isPopupWindow());
+    }
+    return result;
+}
