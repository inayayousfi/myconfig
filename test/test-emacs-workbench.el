                                      universel-atelier-state-directory))
         (file (list :id "file" :kind 'file :file (concat mount "project/file.txt") :persistent t))
         (directory (list :id "directory" :kind 'directory
                          :directory (concat mount "project/") :persistent t))
         (job (list :id "job" :kind 'terminal :persistent t
