(ert-deftest atelier-xref-navigation-stacks-a-single-definition ()
  (require 'xref)
  (let* ((directory (make-temp-file "atelier-xref-" t))
         (first-file (expand-file-name "first.el" directory))
         (second-file (expand-file-name "second.el" directory))
         (workspace (list :id "xref-single" :name "xref" :entries nil))
         (atelier-workspaces (list workspace))
         (atelier-content-live-buffers (make-hash-table :test #'equal))
         (old-selection (atelier-current-workspace-id))
         first entry)
    (unwind-protect
        (save-window-excursion
          (write-region "first" nil first-file nil 'silent)
          (write-region "second" nil second-file nil 'silent)
          (atelier-select-workspace workspace)
          (setq first (find-file-noselect first-file))
          (switch-to-buffer first)
          (setq entry (atelier-register-buffer first workspace nil 'file))
          (cl-letf (((symbol-function 'xref--read-identifier) (lambda (&rest _) "first"))
                    ((symbol-function 'xref--create-fetcher)
                     (lambda (&rest _)
                       (lambda () (list (xref-make "second"
                                                    (xref-make-file-location second-file 1 0)))))))
            (atelier-xref-find-definitions))
          (should (equal (buffer-file-name) second-file))
          (should (eq (atelier-workspace-entry-for-buffer workspace (current-buffer))
                      entry))
          (should (= (length (atelier-entry-stack entry)) 2))
          (should (= (length (atelier-workspace-entries workspace)) 1)))
      (set-frame-parameter nil 'atelier-workspace-id old-selection)
      (dolist (buffer (buffer-list))
        (when (member (buffer-file-name buffer) (list first-file second-file))
          (kill-buffer buffer)))
      (delete-directory directory t))))

(ert-deftest atelier-xref-navigation-stacks-a-chosen-implementation ()
  (require 'xref)
  (let* ((directory (make-temp-file "atelier-xref-list-" t))
         (first-file (expand-file-name "first.el" directory))
         (second-file (expand-file-name "second.el" directory))
         (third-file (expand-file-name "third.el" directory))
         (workspace (list :id "xref-list" :name "xref" :entries nil))
         (atelier-workspaces (list workspace))
         (atelier-content-live-buffers (make-hash-table :test #'equal))
         (old-selection (atelier-current-workspace-id))
         entry)
    (unwind-protect
        (save-window-excursion
          (dolist (file (list first-file second-file third-file))
            (write-region "contents" nil file nil 'silent))
          (atelier-select-workspace workspace)
          (switch-to-buffer (find-file-noselect first-file))
          (setq entry (atelier-register-buffer (current-buffer) workspace nil 'file))
          (cl-letf (((symbol-function 'eglot-find-implementation)
                     (lambda () (interactive)
                       (xref-show-xrefs
                        (lambda () (list (xref-make "second"
                                                     (xref-make-file-location second-file 1 0))
                                         (xref-make "third"
                                                    (xref-make-file-location third-file 1 0))))
                        nil))))
            (atelier-xref-find-implementation))
          (switch-to-buffer "*xref*")
          (should (derived-mode-p 'xref--xref-buffer-mode))
              (should (equal atelier-xref-source
                             (cons (atelier-workspace-id workspace) (plist-get entry :id))))
          (goto-char (point-min))
          (advice-add 'xref--show-pos-in-buf :around #'atelier-xref-preview)
          (unwind-protect
              (let ((window-buffer-change-functions
                     (cons #'atelier-register-visible-frame-buffers
                           window-buffer-change-functions)))
                (xref-next-line)
                (should (= (length (atelier-workspace-entries workspace)) 1))
                (should (= (length (atelier-entry-stack entry)) 1)))
            (advice-remove 'xref--show-pos-in-buf #'atelier-xref-preview))
          (atelier-xref-select #'xref-goto-xref)
          (should (equal (buffer-file-name) second-file))
          (should (eq (atelier-workspace-entry-for-buffer workspace (current-buffer))
                      entry))
          (should (= (length (atelier-entry-stack entry)) 2))
          (should (= (length (atelier-workspace-entries workspace)) 1)))
      (set-frame-parameter nil 'atelier-workspace-id old-selection)
      (dolist (buffer (buffer-list))
        (when (member (buffer-file-name buffer)
                      (list first-file second-file third-file))
          (kill-buffer buffer)))
      (when-let* ((xref (get-buffer "*xref*"))) (kill-buffer xref))
      (delete-directory directory t))))

