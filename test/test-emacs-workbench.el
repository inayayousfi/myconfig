         (good (expand-file-name "good.txt" directory))
         (gone (expand-file-name "gone.txt" directory))
         (view (list :id "fallback-view" :displayed t :selected t
                     :content-ids '("gone" "blocked" "good")))
         (workspace (list :id "fallback-work" :name "fallback-work"
                          :destination "local" :path directory :entries (list view)
                          :contents (mapcar (lambda (pair)
                                              (list :id (car pair) :kind 'file :type 'file
