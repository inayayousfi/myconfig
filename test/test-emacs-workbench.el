(ert-deftest atelier-persist-retains-unmounted-windows-views-without-connecting ()
  (let* ((universel-atelier-state-directory "/tmp/atelier-unmounted-test/")
         (atelier-local-path-p-function #'universel-atelier-local-path-p)
