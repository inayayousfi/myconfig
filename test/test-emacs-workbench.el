         buffer)
    (unwind-protect
        (save-window-excursion
          (with-temp-file blocked (insert "retained despite unreadable content"))
          (with-temp-file good (insert "usable content"))
          (cl-letf (((symbol-function 'atelier-persist-record-pruning) #'ignore)
                    ((symbol-function 'file-readable-p)
                     (lambda (path) (and (not (equal path blocked))
                                        (funcall original-readable path)))))
