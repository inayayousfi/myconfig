(ert-deftest atelier-shared-terminal-restarts-once-and-retains-views-on-uncertain-failure ()
  (dolist (fail '(nil t))
    (let* ((one (list :id "shared-job-one" :kind 'terminal :type 'terminal :persistent t
                      :job (list :buffer "*shared-job*" :recipe
                                 '(:executable "/bin/sh" :argv ("/bin/sh") :directory "/tmp/"))))
           (workspace (list :id "shared-jobs" :name "jobs" :entries (list one)))
           (atelier-workspaces (list workspace))
           (atelier-content-live-buffers (make-hash-table :test #'equal))
           (calls 0) buffer)
      (atelier-entry-content one workspace)
      (let ((two (list :id "shared-job-two" :content-ids (copy-sequence (plist-get one :content-ids)))))
        (atelier-entry-add workspace two t)
        (should (= (length (atelier-build-restart-plan workspace)) 1))
        (unwind-protect
            (cl-letf (((symbol-function 'atelier-workspace-stop-jobs) #'ignore)
                      ((symbol-function 'atelier-persist-record-pruning) #'ignore)
                      ((symbol-function 'ghostel-atelier-buffer)
                       (lambda (_name _dir _exe _args _workspace _shell _agent type &rest _)
                         (cl-incf calls)
                         (should (eq type 'terminal))
                         (when fail (error "Injected launch failure"))
                         (setq buffer (generate-new-buffer "*shared-job*"))
                         (atelier-entry-set-live-buffer atelier-job-owner-entry buffer)
                         buffer)))
              (atelier-restart-saved-jobs workspace)
              (should (= calls 1))
              (if fail
                  (progn (should (= (length (atelier-workspace-entries workspace)) 2))
                         (should (plist-get workspace :contents)))
                (should (= (length (atelier-workspace-entries workspace)) 2))
                (should (eq (atelier-entry-live-buffer one) (atelier-entry-live-buffer two)))))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

