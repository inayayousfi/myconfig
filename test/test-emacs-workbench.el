(ert-deftest myconfig-highlight-copy-uses-copied-region ()
  (with-temp-buffer
    (insert "copied text")
    (let (highlighted)
      (cl-letf (((symbol-function 'pulse-momentary-highlight-region)
                 (lambda (beg end &rest _) (setq highlighted (cons beg end))))
                ((symbol-function 'redisplay) #'ignore))
        (myconfig-highlight-copy 1 7)
        (should (equal highlighted '(1 . 7)))))))

(ert-deftest myconfig-search-combines-files-and-text ()
  (let (called sources)
    (cl-letf (((symbol-function 'myconfig-project-root) (lambda () "/project/"))
              ((symbol-function 'myconfig-search-text-source)
               (lambda (_root) (list :name "Text" :async #'ignore)))
              ((symbol-function 'myconfig-project-file-candidates)
               (lambda (_root) '("/project/linux/modules/pipewire.sh")))
              ((symbol-function 'consult--multi)
               (lambda (choices &rest options)
                 (setq sources choices)
                 (should (equal options '(:prompt "Search: " :require-match t :sort nil)))
                 (should (equal (funcall (plist-get (cadr choices) :items))
                                '("linux/modules/pipewire.sh")))
                 (should-not (plist-get (cadr choices) :category))
                 (funcall (plist-get (cadr choices) :action)
                          "linux/modules/pipewire.sh")))
              ((symbol-function 'atelier-open-file)
               (lambda (file) (setq called file))))
      (myconfig-search)
      (should (equal (mapcar (lambda (source) (plist-get source :name)) sources)
                     '("Text" "Files")))
      (should (equal called "/project/linux/modules/pipewire.sh")))))

(ert-deftest myconfig-search-ripgrep-searches-project-only-once ()
  (require 'consult)
  (let* ((consult-ripgrep-args myconfig-search-ripgrep-args)
         (command (car (funcall (consult--ripgrep-make-builder
                                '("/project/")) "some-text"))))
    (should (equal (car (last command)) "/project/"))
    (should-not (member "." command))
    (should (= (cl-count "/project/" command :test #'equal) 1))))

(ert-deftest myconfig-search-selection-skips-choice-and-searches-text ()
  (with-temp-buffer
    (insert "foo.bar")
    (goto-char (point-min))
    (set-mark (point-max))
    (setq-local transient-mark-mode t)
    (setq mark-active t)
    (let (called)
      (cl-letf (((symbol-function 'myconfig-project-root) (lambda () "/project/"))
                ((symbol-function 'myconfig-search-combined)
                 (lambda (&rest _) (ert-fail "Selection should skip combined search")))
                ((symbol-function 'myconfig-search-text)
                 (lambda (root &optional text) (setq called (list root text)))))
        (myconfig-search))
      (should (equal called '("/project/" "foo.bar"))))))

(ert-deftest myconfig-search-text-source-falls-back-without-programs ()
  (let (source)
    (cl-letf (((symbol-function 'executable-find) (lambda (_name) nil))
              ((symbol-function 'myconfig-project-file-candidates)
               (lambda (_root) '("one.txt")))
              ((symbol-function 'consult--async-dynamic)
               (lambda (function) (setq source function) #'ignore)))
      (let ((result (myconfig-search-text-source "/project/")))
        (should (equal (plist-get result :name) "Text (Emacs)"))
        (should (plist-get result :async))
        (should (functionp source))))))

(ert-deftest myconfig-search-text-source-prefers-rg-then-grep ()
  (let (available builder)
    (cl-letf (((symbol-function 'executable-find)
               (lambda (name) (member name available)))
              ((symbol-function 'consult--ripgrep-make-builder)
               (lambda (_paths) (setq builder 'rg) #'ignore))
              ((symbol-function 'consult--grep-make-builder)
               (lambda (_paths) (setq builder 'grep) #'ignore))
              ((symbol-function 'consult--process-collection)
               (lambda (&rest _) #'ignore))
              ((symbol-function 'consult--grep-format)
               (lambda (_builder) #'ignore)))
      (setq available '("rg" "grep"))
      (should (equal (plist-get (myconfig-search-text-source "/project/") :name)
                     "Text (rg)"))
      (should (eq builder 'rg))
      (setq available '("grep"))
      (should (equal (plist-get (myconfig-search-text-source "/project/") :name)
                     "Text (grep)"))
      (should (eq builder 'grep)))))

(ert-deftest myconfig-search-text-candidates-finds-literal-phrase ()
  (let* ((directory (make-temp-file "myconfig-search-" t))
         (file (expand-file-name "notes.txt" directory))
         (root (file-name-as-directory directory)))
    (unwind-protect
        (progn
          (with-temp-file file (insert "first line\nfoo.bar with two words\n"))
          (let* ((matches (myconfig-search-text-candidates
                           root '("notes.txt") "foo\\.bar\\ with\\ two\\ words"))
                 (location (get-text-property
                            0 'myconfig-search-location (car matches))))
            (should (= (length matches) 1))
            (should (string-prefix-p "notes.txt:2:" (car matches)))
            (should (equal (car location) file))
            (should (= (cdr location) 12))))
      (delete-file file)
      (delete-directory directory))))

(ert-deftest myconfig-search-text-uses-available-program-or-emacs ()
  (let (available called)
    (cl-letf (((symbol-function 'executable-find)
               (lambda (name) (and (member name available) name)))
              ((symbol-function 'consult-ripgrep)
               (lambda (root initial) (setq called (list 'rg root initial))))
              ((symbol-function 'consult-grep)
               (lambda (root initial) (setq called (list 'grep root initial))))
              ((symbol-function 'myconfig-project-file-candidates)
               (lambda (_root) '("one.txt" "two.txt")))
              ((symbol-function 'find-file-noselect)
               (lambda (file) file))
              ((symbol-function 'multi-occur)
               (lambda (buffers regexp) (setq called (list 'occur buffers regexp)))))
      (setq available '("rg" "grep"))
      (myconfig-search-text "/project/" "foo.bar")
      (should (equal called '(rg "/project/" "foo\\.bar")))
      (setq available '("grep"))
      (myconfig-search-text "/project/" "foo.bar")
      (should (equal called '(grep "/project/" "foo\\.bar")))
      (myconfig-search-text "/project/" "two words")
      (should (equal called '(grep "/project/" "two\\ words")))
      (setq available nil)
      (myconfig-search-text "/project/" "foo.bar")
      (should (equal called '(occur ("/project/one.txt" "/project/two.txt")
                                   "foo\\.bar"))))))

