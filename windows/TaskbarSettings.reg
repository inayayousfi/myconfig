Windows Registry Editor Version 5.00

; Explorer visibility
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"Hidden"=dword:00000001
"HideFileExt"=dword:00000000
"ShowSuperHidden"=dword:00000000
"ShowStatusBar"=dword:00000001
"ShowCompColor"=dword:00000001

; Taskbar
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"TaskbarAl"=dword:00000000
"ShowTaskViewButton"=dword:00000001
"TaskbarDa"=dword:00000000
"TaskbarBadges"=dword:00000001
"TaskbarFlashing"=dword:00000001
"TaskbarGlomLevel"=dword:00000001
"MMTaskbarGlomLevel"=dword:00000001
"ShowSystrayDateTimeValueName"=dword:00000001
"IsBatteryPercentageEnabled"=dword:00000001

; Taskbar search
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Search]
"SearchboxTaskbarMode"=dword:00000000

; Start menu
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"Start_IrisRecommendations"=dword:00000000
"Start_TrackDocs"=dword:00000000
"Start_RecoPersonalizedSites"=dword:00000000
"Start_AccountNotifications"=dword:00000000

; Developer taskbar settings
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced\TaskbarDeveloperSettings]
"TaskbarEndTask"=dword:00000001
